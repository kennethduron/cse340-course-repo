<%- include('partials/header') %>
<section class="section-block"><div class="container form-card">
  <h1><%= title %></h1>
  <form action="/edit-category/<%= category.category_id %>" method="post">
    <label for="name">Category name</label>
    <input id="name" name="name" type="text" value="<%= category.name %>" required maxlength="100">
    <button class="button primary" type="submit">Update Category</button>
  </form>
</div></section>
<%- include('partials/footer') %>
