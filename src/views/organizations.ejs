<%- include('partials/header') %>

<section class="section-block">
  <div class="container">
    <h1><%= title %></h1>

    <div class="organization-grid">
      <article class="org-card">
        <img src="/images/brightfuture-logo.svg" alt="BrightFuture logo" />
        <h2>BrightFuture</h2>
        <p>Expands educational opportunities and youth mentorship through inclusive community learning programs.</p>
      </article>

      <article class="org-card">
        <img src="/images/greenharvest-logo.svg" alt="GreenHarvest logo" />
        <h2>GreenHarvest</h2>
        <p>Supports sustainable agriculture, environmental stewardship, and community gardens in urban neighborhoods.</p>
      </article>

      <article class="org-card">
        <img src="/images/unityserve-logo.svg" alt="UnityServe logo" />
        <h2>UnityServe</h2>
        <p>Coordinates volunteer outreach and local support networks for vulnerable families and community partners.</p>
      </article>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
