<%- include('partials/header') %>

<section class="hero section-block">
  <div class="container hero-layout">
    <div class="hero-copy">
      <p class="section-kicker">Community impact</p>
      <h1><%= title %></h1>
      <p>
        The CSE 340 Service Network connects communities, volunteers, and partner organizations
        to deliver meaningful service projects that strengthen neighborhoods and improve lives.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/organizations">Explore Organizations</a>
        <a class="button secondary" href="/projects">View Projects</a>
      </div>
    </div>
    <div class="hero-visual">
      <img src="/images/cse340-service-network.png" alt="CSE 340 Service Network community service illustration" />
    </div>
  </div>
</section>

<section class="section-block">
  <div class="container">
    <h2>Our mission</h2>
    <div class="feature-grid">
      <article class="info-card">
        <h3>Volunteer support</h3>
        <p>Empower individuals and teams to contribute time and expertise to important local needs.</p>
      </article>
      <article class="info-card">
        <h3>Strong partnerships</h3>
        <p>Collaborate with nonprofits, civic groups, and service-minded organizations to scale impact.</p>
      </article>
      <article class="info-card">
        <h3>Meaningful projects</h3>
        <p>Support initiatives focused on environmental care, education, health, and community well-being.</p>
      </article>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
