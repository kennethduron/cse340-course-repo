<%- include('partials/header') %>

  <section class="section-block">
    <div class="container">
      <h1>
        <%= title %>
      </h1>

      <div class="project-list">
        <% projects.forEach((project)=> { %>
          <article class="project-card">
            <p>
              <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC' , year: 'numeric' , month: 'long'
                , day: 'numeric' }) %>
            </p>
            <h2>
              <%= project.title %>
            </h2>
            <p>
              <%= project.organization_name %>
            </p>
            <p>
              <%= project.description %>
            </p>
            <p>
              <%= project.location %>
            </p>
          </article>
          <% }); %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>