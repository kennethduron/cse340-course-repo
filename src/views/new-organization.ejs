<%- include('partials/header') %>
<section class="section-block"><div class="container form-card">
  <h1><%= title %></h1>
  <form action="/new-organization" method="post">
    <label for="name">Organization name</label>
    <input id="name" name="name" type="text" required maxlength="150">
    <label for="description">Description</label>
    <textarea id="description" name="description" required maxlength="500"></textarea>
    <label for="contactEmail">Contact email</label>
    <input id="contactEmail" name="contactEmail" type="email" required>
    <button class="button primary" type="submit">Add Organization</button>
  </form>
</div></section>
<%- include('partials/footer') %>
